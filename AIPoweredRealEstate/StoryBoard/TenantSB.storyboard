    <scenes>
        <!--Tenant Tab Bar Controller-->
        <scene sceneID="scene-tenant-tab">
            <objects>
                <tabBarController storyboardIdentifier="TenantTabBarController" id="tenant-tab" customClass="TenantTabBarController" customModule="AIPoweredRealEstate" customModuleProvider="target" sceneMemberID="viewController">
                    <tabBar key="tabBar" contentMode="scaleToFill" id="tb-tenant">
                        <rect key="frame" x="0.0" y="803" width="393" height="49"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        <color key="tintColor" red="0.55294117647058827" green="0.098039215686274508" blue="0.098039215686274508" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <color key="selectedImageTintColor" red="0.55294117647058827" green="0.098039215686274508" blue="0.098039215686274508" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    </tabBar>
                    <connections>
                        <segue destination="nav-thome" kind="relationship" relationship="viewControllers" id="seg-tab-home"/>
                        <segue destination="nav-tsearch" kind="relationship" relationship="viewControllers" id="seg-tab-search"/>
                        <segue destination="nav-tsaved" kind="relationship" relationship="viewControllers" id="seg-tab-saved"/>
                        <segue destination="nav-tprofile" kind="relationship" relationship="viewControllers" id="seg-tab-profile"/>
                    </connections>
                </tabBarController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="fr-tenant-tab" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-780" y="0.0"/>
        </scene>
        <!--Home-->
        <scene sceneID="scene-nav-thome">
            <objects>
                <navigationController navigationBarHidden="YES" id="nav-thome" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="Home" image="house.fill" catalog="system" selectedImage="house.fill" id="tbi-home"/>
                    <navigationBar key="navigationBar" hidden="YES" contentMode="scaleToFill" id="nb-thome">
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="vc-thome" kind="relationship" relationship="rootViewController" id="seg-home-root"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="fr-nav-thome" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="20" y="-720"/>
        </scene>
